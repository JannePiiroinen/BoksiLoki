# Neon Postgres
DATABASE_URL=

# Anthropic API (WOD-generaattori, kuvatulkinta, kehitysraportti)
ANTHROPIC_API_KEY=

# Kustannusseuranta: hinta USD per miljoona tokenia käytetylle mallille (nyt claude-sonnet-4-6).
# Tarkista arvot Anthropicin hinnastosta (https://claude.com/pricing) ja päivitä, jos malli tai hinta muuttuu.
# Ilman näitä tokenit ja latenssi kirjataan silti, mutta kustannus jää tyhjäksi.
PRICE_INPUT_PER_MTOK=3
PRICE_OUTPUT_PER_MTOK=15

# Stripe (kuukausitilaus 10€/kk). Käytä ensin test-tilan avaimia (sk_test_..., price_...).
# STRIPE_WEBHOOK_SECRET saadaan Dashboardin webhook-endpointilta tai komennolla: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Tilausvaatimus AI-toiminnoille. Pois päältä oletuksena, true kytkee päälle.
REQUIRE_SUBSCRIPTION=false

# AI-käyttörajat (valinnaisia - ilman näitä käytetään alla olevia oletuksia).
# Kuukausiraja per käyttäjä kalenterikuukaudessa (Suomen aikaa) ja globaali hätäjarru kaikille käyttäjille / 24 h.
LIMIT_WOD_MONTH=30
LIMIT_PHOTO_MONTH=20
LIMIT_REPORT_MONTH=5
LIMIT_GLOBAL_DAY=300
